{
  "sections": [
    {
      "key": "channel",
      "label": "Recipients",
      "fields": [
        {
          "type": "textarea",
          "key": "addresses",
          "label": "Addresses",
          "required": true,
          "placeholder": "One address per line"
        },
        {
          "type":        "alert-template",
          "key":         "subject",
          "label":       "Subject",
          "placeholder": "[{{ .Status | upper }}] {{ .CommonLabels.alertname }}"
        },
        {
          "type":        "alert-template",
          "key":         "body",
          "label":       "Body",
          "placeholder": "{{ range .FiringAlerts }}[{{ .RuleTitle }}] value={{ .Value }}\n{{ end }}"
        }
      ]
    },
    {
      "key": "smtp",
      "label": "SMTP Server",
      "defaultOpen": false,
      "fields": [
        {
          "type": "input",
          "key": "host",
          "label": "SMTP Host",
          "required": true
        },
        {
          "type": "number",
          "key": "port",
          "label": "SMTP Port",
          "defaultValue": 587
        },
        { "type": "input", "key": "username", "label": "Username" },
        { "type": "input", "key": "password", "label": "Password" },
        {
          "type": "input",
          "key": "from",
          "label": "From Address",
          "required": true
        },
        {
          "type": "switch",
          "key": "startTLS",
          "label": "Enable StartTLS",
          "defaultValue": false
        }
      ]
    }
  ]
}
